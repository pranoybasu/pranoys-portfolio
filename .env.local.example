# Email Service Configuration
# Choose ONE of the following email services and configure accordingly

# ============================================
# OPTION 1: Resend (Recommended)
# Sign up at: https://resend.com
# Free tier: 100 emails/day
# Uncomment and add your API key
# ============================================
# RESEND_API_KEY=your_resend_api_key_here

# ============================================
# OPTION 2: SendGrid
# Sign up at: https://sendgrid.com
# Free tier: 100 emails/day
# Uncomment and add your API key
# ============================================
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# ============================================
# GitHub API (Optional)
# Currently using unauthenticated requests (60 req/hour limit)
# Add a personal access token to increase rate limit to 5000 req/hour
# https://github.com/settings/tokens (Create token with "public_repo" scope)
# ============================================
# GITHUB_TOKEN=your_github_personal_access_token

# ============================================
# Analytics (Optional)
# Add your analytics service keys here
# ============================================
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id

# ============================================
# Contact Email Configuration
TO_EMAIL=pranoybasuch@gmail.com
FROM_EMAIL=noreply@pranoybasu.dev
